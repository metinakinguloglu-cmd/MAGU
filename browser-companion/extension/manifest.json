{
  "manifest_version": 3,
  "name": "MAGU Browser Companion",
  "version": "0.1.0",
  "description": "YouTube bağlantılarını MAGU ile güvenli biçimde indirmeye hazırlar.",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"],
  "background": {"service_worker": "service-worker.js"},
  "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}],
  "action": {"default_title": "MAGU"}
}
